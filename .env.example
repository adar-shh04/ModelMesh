# ModelMesh environment variables: NAMES ONLY. Copy to .env and fill in locally; never commit .env.

# --- Service ---
MODELMESH_ENV=
MODELMESH_LOG_LEVEL=
MODELMESH_API_HOST_PORT=
MODELMESH_DEFAULT_TIMEOUT_MS=
MODELMESH_MAX_TIMEOUT_MS=
MODELMESH_MAX_BODY_BYTES=
MODELMESH_STREAM_IDLE_TIMEOUT_S=
MODELMESH_STREAM_KEEPALIVE_S=

# --- Security (secrets; required) ---
MODELMESH_API_KEY_PEPPER=
MODELMESH_ADMIN_TOKEN=

# --- Persistence ---
MODELMESH_DATABASE_URL=
MODELMESH_REDIS_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MODELMESH_PG_HOST_PORT=
MODELMESH_REDIS_HOST_PORT=

# --- Providers (secrets; leave empty to keep a provider disabled) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
OLLAMA_BASE_URL=

# --- Catalog / limits / cache ---
MODELMESH_MODEL_CATALOG_PATH=
MODELMESH_PRICING_PATH=
MODELMESH_CACHE_THRESHOLDS_PATH=
MODELMESH_EMBEDDING_MODEL=
MODELMESH_EMBEDDING_THREADS=
MODELMESH_CACHE_DEFAULT_TTL_S=
MODELMESH_CACHE_MAX_TTL_S=
MODELMESH_SEMANTIC_CACHE_ENABLED=
MODELMESH_CONTENT_RETENTION_TTL_DAYS=
MODELMESH_DEFAULT_KEY_RPM=
MODELMESH_DEFAULT_KEY_TPM=
MODELMESH_DEFAULT_KEY_CONCURRENCY=
MODELMESH_DEFAULT_KEY_DAILY_BUDGET_USD=
MODELMESH_ENABLE_FAKE_PROVIDER=
FASTEMBED_CACHE_PATH=

# --- Observability (OpenTelemetry) ---
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
MODELMESH_OTLP_METRICS_ENABLED=
MODELMESH_JAEGER_UI_HOST_PORT=
# Base URL the dashboard uses for trace links (default http://127.0.0.1:16686).
MODELMESH_JAEGER_UI_URL=

# --- Benchmark harness (offline only) ---
HF_HOME=
MODELMESH_BENCH_BASE_URL=
MODELMESH_BENCH_API_KEY=
