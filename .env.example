# ModelMesh environment variables: NAMES ONLY. Copy to .env and fill in locally; never commit .env.

# --- Service ---
MODELMESH_ENV=
MODELMESH_LOG_LEVEL=
MODELMESH_API_HOST_PORT=
MODELMESH_DEFAULT_TIMEOUT_MS=
MODELMESH_MAX_TIMEOUT_MS=
MODELMESH_MAX_BODY_BYTES=

# --- Security (secrets) ---
MODELMESH_API_KEY_PEPPER=
MODELMESH_ADMIN_TOKEN=

# --- Persistence ---
MODELMESH_DATABASE_URL=
MODELMESH_REDIS_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MODELMESH_PG_HOST_PORT=
MODELMESH_REDIS_HOST_PORT=

# --- Providers (secrets; leave empty to keep a provider disabled) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
OLLAMA_BASE_URL=

# --- Catalog / routing / cache ---
MODELMESH_MODEL_CATALOG_PATH=
MODELMESH_PRICING_PATH=
MODELMESH_ROUTER_ARTIFACT_PATH=
MODELMESH_EMBEDDING_MODEL=
MODELMESH_CACHE_DEFAULT_TTL_S=
MODELMESH_CACHE_MAX_TTL_S=
MODELMESH_CONTENT_RETENTION_DEFAULT=
MODELMESH_ENABLE_FAKE_PROVIDER=

# --- Observability (OpenTelemetry) ---
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
MODELMESH_JAEGER_UI_HOST_PORT=

# --- ML / benchmarking (offline only) ---
MLFLOW_TRACKING_URI=
HF_HOME=
MODELMESH_BENCH_BASE_URL=
MODELMESH_BENCH_API_KEY=
